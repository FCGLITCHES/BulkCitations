{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:pentest": "tsx scripts/security/pentest.ts",
    "security:fuzz": "tsx scripts/security/fuzz.ts",
    "security:realistic": "tsx scripts/security/realistic.ts",
    "profile:pipeline": "tsx scripts/profile-pipeline.ts --assert-budget",
    "diagnostics:admin-throughput-gap": "tsx scripts/diagnostics/admin-throughput-gap.ts",
    "diagnostics:fixed-batch-smoke": "tsx scripts/diagnostics/fixed-batch-smoke.ts",
    "diagnostics:fixed-batch-smoke:assert": "tsx scripts/diagnostics/fixed-batch-smoke.ts --assert-gates",
    "test:webhook-workos": "node scripts/send-workos-webhook-test.mjs",
    "test:webhook-clerk": "tsx scripts/send-clerk-webhook-test.ts",
    "test:clerk-jwt": "tsx scripts/test-clerk-jwt.ts",
    "set-admin": "tsx scripts/set-admin-by-email.ts",
    "seed:approved-truth": "tsx scripts/seed-approved-truth-from-jsonl.ts ../ml-service/training/fixture_export.jsonl",
    "authority-pack:build": "tsx scripts/build-authority-pack.ts",
    "training:style-harvest": "tsx scripts/harvest-style-gold-candidates.ts",
    "training:style-export": "tsx scripts/export-style-gold.ts",
    "benchmark:generate": "tsx scripts/benchmark/generate-corpus.ts",
    "benchmark:run": "tsx scripts/benchmark/run-engine.ts",
    "benchmark:evaluate": "tsx scripts/benchmark/evaluate.ts",
    "benchmark:gate": "tsx scripts/benchmark/ci-gate.ts",
    "benchmark:pathological:run": "tsx scripts/benchmark/run-engine.ts --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=grobid_compare --slicePreset=pathological_3001_3400",
    "benchmark:pathological:evaluate": "tsx scripts/benchmark/evaluate.ts --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=grobid_compare --slicePreset=pathological_3001_3400",
    "benchmark:pathological:gate": "tsx scripts/benchmark/ci-gate.ts --mode=full --profile=current-runtime --hardwareProfile=benchmark_5600h --benchmarkVariant=grobid_compare --slicePreset=pathological_3001_3400",
    "benchmark:pathological:parallel:run": "tsx scripts/benchmark/run-engine.ts --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --slicePreset=pathological_3001_3400",
    "benchmark:pathological:parallel:evaluate": "tsx scripts/benchmark/evaluate.ts --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --slicePreset=pathological_3001_3400",
    "benchmark:pathological:parallel:gate": "tsx scripts/benchmark/ci-gate.ts --mode=full --profile=current-runtime --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --slicePreset=pathological_3001_3400",
    "benchmark:style-winloss": "tsx scripts/benchmark/style-winloss.ts",
    "benchmark:baseline": "tsx scripts/benchmark/refresh-baseline.ts",
    "benchmark:series": "tsx scripts/benchmark/run-series.ts",
    "benchmark:sweep:parallel": "tsx scripts/benchmark/sweep-parallel.ts --mode=full --profile=current-runtime-stable350 --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --artifactDetail=summary --iterations=3",
    "benchmark:stable350:parallel": "tsx scripts/benchmark/run-series.ts --iterations=5 --mode=full --profile=current-runtime-stable350 --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --artifactNamespace=stable350 --artifactDetail=summary --continueOnGateFailure=true --requireFieldHashStable=true --requireContractHashStable=true --requireGatePassAll=true --minThroughput=350 --minP10Throughput=350 --maxRssGiB=2.75",
    "benchmark:canonical:direct": "tsx scripts/benchmark/run-series.ts --iterations=3 --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=grobid_compare --artifactNamespace=full_canonical",
    "benchmark:canonical:parallel": "tsx scripts/benchmark/run-series.ts --iterations=3 --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --artifactNamespace=full_canonical",
    "benchmark:grobid3500:direct": "tsx scripts/benchmark/run-series.ts --iterations=3 --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=grobid_compare --artifactNamespace=grobid_3500_citation_list --slicePreset=grobid_3500_citation_list",
    "benchmark:grobid3500:parallel": "tsx scripts/benchmark/run-series.ts --iterations=3 --mode=full --profile=current-runtime --parseProfile=core_parse_fast --sourceType=text --hardwareProfile=benchmark_5600h --benchmarkVariant=parallel --artifactNamespace=grobid_3500_citation_list --slicePreset=grobid_3500_citation_list",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:repair-admin-review": "tsx scripts/repair-admin-review.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@upstash/redis": "^1.35.0",
    "@workos-inc/node": "^8.10.0",
    "citeproc": "^2.4.63",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "fastify": "^5.8.4",
    "ioredis": "^5.3.2",
    "jose": "^6.2.2",
    "openai": "^6.33.0",
    "pg": "^8.11.5",
    "pino": "^9.2.0",
    "svix": "^1.90.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^2.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.16.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
