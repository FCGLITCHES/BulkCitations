# =============================================================================
# BulkReferences — copy to .env and fill in secrets.
# Vite loads from repo root (frontend/vite.config envDir = parent); VITE_* here
# applies to the web client build.
# =============================================================================

NODE_ENV=development
# API server (4000 avoids Windows Hyper-V reserved 3101-3200; use 3111 on Linux/macOS if preferred)
PORT=4000
FRONTEND_PORT=2397

# Comma-separated browser origins allowed by CORS (defaults in code if unset)
CORS_ALLOWED_ORIGINS=https://bulkreferences.com,https://www.bulkreferences.com,http://localhost:3000,http://localhost:2397

# database = durable app/runtime persistence
# transient test persistence is internal-only and is not a supported operator setting
PERSISTENCE_BACKEND=database

# -----------------------------------------------------------------------------
# Database (Postgres / Drizzle)
# -----------------------------------------------------------------------------
# Local Docker / Neon: use pooled `postgresql://…@ep-….neon.tech/neondb?sslmode=require` in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bulkreferences
# disable | prefer | require
DATABASE_SSL_MODE=prefer
# true (default): verify DB certificate chain/host.
# false: allow encrypted-but-unverified TLS (dev escape hatch only).
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Redis — optional integration/cache URL. Leave unset unless you explicitly want Redis.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Hosted Redis example: redis://default:password@host:port or rediss://default:password@host:port
# Upstash: copy **Redis** connection string (rediss://...) from the dashboard — not the REST URL.
UPSTASH_REDIS_URL=
# Optional REST API (HTTP); same project as above. Used by getUpstashRest() — does not replace TCP for queues.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# auto | redis | upstash (reserved for provider selection)
REDIS_PROVIDER=auto
# queue_first (default): Redis for BullMQ durability + auth revocation only (low-memory friendly)
# balanced: also enable Redis-backed API rate limits and provider caches
REDIS_USAGE_MODE=queue_first

# -----------------------------------------------------------------------------
# OpenAI (Phase 6.5 LLM fallback)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
# Chat Completions model for Phase 6.5 LLM repair (override if OpenAI renames the id)
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=8000
# ENABLE_LLM_EXTRACTOR is legacy alias for enabling the repair path
ENABLE_LLM_FALLBACK=true
ENABLE_LLM_EXTRACTOR=false
LLM_REPAIR_BUDGET_FREE=10
LLM_REPAIR_BUDGET_PRO=50

# -----------------------------------------------------------------------------
# Cloudflare R2 (object storage)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bulkreferences
R2_PUBLIC_URL=

# Large export artifacts: upload to R2 and return signed download URLs
EXPORT_R2_OFFLOAD_ENABLED=false
EXPORT_R2_OFFLOAD_THRESHOLD_BYTES=100000
EXPORT_R2_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# ML microservice (FastAPI)
# -----------------------------------------------------------------------------
# FastAPI ML service (8123 avoids Windows Hyper-V reserved 1108-1207; 8000 if no conflict)
ML_SERVICE_URL=http://localhost:8123
ML_SERVICE_TIMEOUT_MS=25000
ML_ADMIN_SECRET=
ML_INGEST_MAX_BYTES=2000000
# Phase-4 extractor: heuristic | shadow | primary
ML_PHASE4_MODE=heuristic
ML_PHASE4_PRIMARY_FRACTION=0.1
ML_PHASE4_SHADOW_FRACTION=1
ML_CB_FAILURE_THRESHOLD=10
ML_CB_COOLDOWN_MS=60000
ML_MAX_CONCURRENT_REQUESTS=4
ML_MAX_QUEUE_DEPTH=32
ML_QUEUE_WAIT_TIMEOUT_MS=250
ML_HEALTH_POLL_MS=30000

# -----------------------------------------------------------------------------
# External HTTP APIs
# -----------------------------------------------------------------------------
# Crossref: optional email improves polite-pool rate limits (mailto in requests)
CROSSREF_EMAIL=contact@bulkreferences.com
CROSSREF_TIMEOUT_MS=3000
CROSSREF_RETRY_ATTEMPTS=4
CROSSREF_RETRY_BASE_DELAY_MS=250
OPENALEX_TIMEOUT_MS=3000
OPENALEX_RETRY_ATTEMPTS=4
OPENALEX_RETRY_BASE_DELAY_MS=250
RETRACTION_WATCH_TIMEOUT_MS=2000
# Semantic Scholar Graph API (Phase 8 enrichment, last resort after Crossref + OpenAlex; ~1 req/s server-side)
SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------------------
# Sessions & auth (Clerk / WorkOS JWT validation on the API)
# -----------------------------------------------------------------------------
# Production (Render, etc.): set a long random secret — never use the dev placeholder below.
SESSION_SECRET=dev-session-secret-change-in-production
# Legacy DB session cookie name (optional; Bearer session id still supported)
SESSION_COOKIE_NAME=br_session
# ISO 8601 instant after which legacy sessions are rejected (JWT + API keys unaffected)
# AUTH_LEGACY_SESSION_SUNSET_AT=
# internal = JWT Bearer ignored by API (local legacy/API-key only). Use hybrid or external for Clerk/WorkOS.
# hybrid | external — required for /internal/* admin + Bearer validation (set CLERK_JWKS_URL).
AUTH_MODE=hybrid
AUTH_ALLOW_LEGACY_SESSIONS=true
AUTH_ALLOW_API_KEYS=true
# Comma-separated JWT audiences when not using CLERK_JWT_AUDIENCE / WORKOS_JWT_AUDIENCE alone
AUTH_JWT_AUDIENCES=

# Clerk (dashboard → API keys / JWT template). Real values belong only in local .env (gitignored).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: Clerk Dashboard → JWT templates → name (API must use same audience as CLERK_JWT_AUDIENCE).
VITE_CLERK_JWT_TEMPLATE=
# WorkOS AuthKit (institutional SSO on /institutional-login). Client id from WorkOS Dashboard → AuthKit.
VITE_WORKOS_CLIENT_ID=
# Same AuthKit client id on the API (WorkOS browser proxy). Match VITE_WORKOS_CLIENT_ID.
WORKOS_CLIENT_ID=
# Optional: verbose browser console [auth] traces (dev defaults to on; set false to silence). Prod: true or localStorage bulkreferences:debugAuth=1
VITE_DEBUG_AUTH=
CLERK_JWT_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_AUDIENCE=

WORKOS_API_KEY=sk_test_...
WORKOS_JWT_ISSUER=
WORKOS_JWKS_URL=
WORKOS_JWT_AUDIENCE=

CLERK_WEBHOOK_SECRET=
WORKOS_WEBHOOK_SECRET=

# Emergency admin bypass for /internal/* (optional; keep unset in production unless needed)
BREAK_GLASS_SECRET=

# HS256 secret for magic admin-approval links (POST /internal/admin/approve). Generate JWT with { email, purpose: "admin_approve", exp }.
ADMIN_APPROVAL_JWT_SECRET=

# -----------------------------------------------------------------------------
# Rate limiting (API)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
UPLOAD_MAX_BYTES=2000000
TRUST_PROXY_CIDRS=loopback, linklocal, uniquelocal
# Max citation reports per IP per UTC day (POST /v1/reports and /api/engine/v1/reports)
REPORT_LIMIT_PER_IP=10

# -----------------------------------------------------------------------------
# Contact form (About / Contact pages → POST /api/contact) via Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL_TO=
# Sender must be from a domain verified in Resend (dev: onboarding@resend.dev)
RESEND_FROM_EMAIL=BulkReferences <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Pipeline / queue
# -----------------------------------------------------------------------------
PIPELINE_BATCH_SIZE=64
PIPELINE_MAX_CONCURRENCY=8
PIPELINE_FAST_WORKERS_ENABLED=true
PIPELINE_FAST_MULTICORE_MIN_REFS=256
# Estimated reference count above this uses async job path instead of sync
PIPELINE_SYNC_THRESHOLD=500
PIPELINE_STAGE_BUDGET_MS=250

# -----------------------------------------------------------------------------
# Feature flags & PDF ingest tuning
# -----------------------------------------------------------------------------
FEATURE_SCORED_DETECTOR=false
FEATURE_PDF_CLEANUP=true
PDF_CLEANUP_MIN_IMPROVEMENT_DELTA=0.01
PDF_CLEANUP_MAX_CANDIDATE_LENGTH=200000
PDF_CLEANUP_BLOCK_COUNT_DIVERGENCE_RATIO=0.2

# -----------------------------------------------------------------------------
# Frontend (Vite) — set at repo root for `pnpm --dir frontend run dev/build`
# -----------------------------------------------------------------------------
# Empty = same origin / dev proxy. Set for a deployed API on another host.
VITE_API_BASE_URL=
# Dev-only: override proxy target (default http://localhost:$PORT)
VITE_API_PROXY_TARGET=
