{
  "name": "bulkreferences-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:legacy": "pnpm run dev:stop && node scripts/infra-up.mjs && node scripts/ensure-bootstrap-bundle.mjs && concurrently -n server,frontend,ml -c cyan,magenta,yellow \"pnpm --dir server run dev\" \"node scripts/wait-for-tcp.mjs && pnpm --dir frontend run dev\" \"pnpm run dev:ml || exit 0\"",
    "dev:local": "pnpm run dev",
    "dev:frontend": "pnpm --dir frontend run dev",
    "dev:server": "pnpm --dir server run dev",
    "dev:ml": "python -m uvicorn app.main:app --app-dir ml-service --host 0.0.0.0 --port 8123 --reload --reload-dir ml-service/app",
    "dev:stop": "kill-port 3001 3111 4000 5000 2397 8123 1111 5173 8000 || exit 0",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "security:pentest": "pnpm --dir server run security:pentest",
    "security:fuzz": "pnpm --dir server run security:fuzz",
    "security:realistic": "pnpm --dir server run security:realistic",
    "security:all": "pnpm run security:pentest && pnpm run security:fuzz && pnpm run security:realistic",
    "build:frontend": "pnpm --dir frontend run build",
    "build:server": "pnpm --dir server run build",
    "pages:build": "pnpm --dir frontend run build",
    "pages:deploy": "pnpm run pages:build && wrangler pages deploy frontend/dist/public",
    "test:server": "pnpm --dir server run test",
    "profile:pipeline": "pnpm --dir server run profile:pipeline",
    "diagnostics:admin-throughput-gap": "pnpm --dir server run diagnostics:admin-throughput-gap",
    "db:migrate": "pnpm --dir server run db:migrate",
    "db:generate": "pnpm --dir server run db:generate",
    "training:eval": "python ml-service/tools/eval_jsonl.py ml-service/training/fixture_export.jsonl",
    "training:stub": "python ml-service/tools/stub_train.py ml-service/training/fixture_export.jsonl",
    "training:seed-truth": "pnpm --dir server run seed:approved-truth",
    "training:hf-bio-import": "python ml-service/tools/import_hf_bio_gold.py",
    "training:hf-bio-bundle": "python ml-service/tools/train_bio_bundle.py",
    "training:style-export": "pnpm --dir server run training:style-export",
    "training:style-bundle": "python ml-service/tools/train_style_bundle.py ml-service/training/style_gold.jsonl",
    "training:style-promote": "python ml-service/tools/promote_style_bundle.py style-gb-local-reviewed-v1",
    "authority-pack:build": "pnpm --dir server run authority-pack:build",
    "benchmark:generate": "pnpm --dir server run benchmark:generate",
    "benchmark:run": "pnpm --dir server run benchmark:run",
    "benchmark:evaluate": "pnpm --dir server run benchmark:evaluate",
    "benchmark:gate": "pnpm --dir server run benchmark:gate",
    "benchmark:pathological:run": "pnpm --dir server run benchmark:pathological:run",
    "benchmark:pathological:evaluate": "pnpm --dir server run benchmark:pathological:evaluate",
    "benchmark:pathological:gate": "pnpm --dir server run benchmark:pathological:gate",
    "benchmark:pathological:parallel:run": "pnpm --dir server run benchmark:pathological:parallel:run",
    "benchmark:pathological:parallel:evaluate": "pnpm --dir server run benchmark:pathological:parallel:evaluate",
    "benchmark:pathological:parallel:gate": "pnpm --dir server run benchmark:pathological:parallel:gate",
    "benchmark:style-winloss": "pnpm --dir server run benchmark:style-winloss",
    "benchmark:baseline": "pnpm --dir server run benchmark:baseline",
    "benchmark:series": "pnpm --dir server run benchmark:series",
    "benchmark:sweep:parallel": "pnpm --dir server run benchmark:sweep:parallel",
    "benchmark:stable350:parallel": "pnpm --dir server run benchmark:stable350:parallel",
    "benchmark:canonical:direct": "pnpm --dir server run benchmark:canonical:direct",
    "benchmark:canonical:parallel": "pnpm --dir server run benchmark:canonical:parallel",
    "benchmark:grobid3500:direct": "pnpm --dir server run benchmark:grobid3500:direct",
    "benchmark:grobid3500:parallel": "pnpm --dir server run benchmark:grobid3500:parallel",
    "start": "node ./server/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "prettier": "^3.8.3",
    "wrangler": "^4.54.0"
  }
}
