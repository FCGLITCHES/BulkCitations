# [SERVER CONFIG]
PORT=5000
NODE_ENV=development

# [STORAGE]
# Data is stored in the /data folder by default.
# Leave blank to use local filesystem storage.
VERCEL=false

# [ENGINE LIMITS]
# IP-based rate limiting for user reports (count per 24h)
REPORT_LIMIT_PER_IP=10
USE_V2_ENGINE=true

# [EXTERNAL APIS]
# Semantic Scholar API Key (Optional)
# Get one at: https://www.semanticscholar.org/product/api
# Used for verifying citation authority and cross-referencing.
SEMANTIC_SCHOLAR_API_KEY=

# Optional v2 extraction helpers
# Enable GROBID only when the service is healthy and sized for your batch load.
ENABLE_GROBID_EXTRACTOR=false
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_MS=3000
GROBID_COOLDOWN_MS=30000
V2_EXTRACT_CONCURRENCY=1

# Optional OpenAI fallback for v2 split/extract.
# Without OPENAI_API_KEY, LLM fallback is not used.
ENABLE_LLM_EXTRACTOR=true
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-nano
OPENAI_SPLIT_MODEL=gpt-5.4-nano
OPENAI_EXTRACT_TIMEOUT_MS=8000
OPENAI_SPLIT_TIMEOUT_MS=12000
V2_LLM_MAX_CALLS_SYNC=25
V2_LLM_MAX_CALLS_ASYNC=100

# [EMAIL & NOTIFICATIONS]
RESEND_API_KEY=
CONTACT_EMAIL_TO=support@bulkreferences.com

# [ADMIN]
# Strong server-side password for admin login. Never commit the real value.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
# [SERVER CONFIG]
PORT=5000
NODE_ENV=production
VERCEL=false

# [PRODUCTION REQUIRED NOW]
