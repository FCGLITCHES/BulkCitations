{
  "manifest_version": 3,
  "name": "BulkCitations Capture",
  "version": "1.0.0",
  "description": "Collect references from any page and open them in BulkCitations.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
